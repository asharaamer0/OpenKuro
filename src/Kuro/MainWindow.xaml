<Window x:Class="Kuro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Kuro" xmlns:ui="clr-namespace:Kuro.UI" Title="Kuro" Background="{DynamicResource Workspace}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="12" UseLayoutRounding="True" Width="1480" Height="920" MinWidth="1050" MinHeight="660" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="WindowDrop" PreviewKeyDown="WindowKeyDown">
 <Grid x:Name="AppGrid" Background="{DynamicResource Workspace}" SizeChanged="WorkspaceSizeChanged">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AISplitterColumn" Width="0"/><ColumnDefinition x:Name="AISidebarColumn" Width="0"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition x:Name="TimelineRow" Height="300" MinHeight="170"/><RowDefinition Height="27"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
   <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource KuroMark}" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock Text="kuro" FontSize="18" FontWeight="SemiBold" Margin="8,0,26,0"/></StackPanel>
    <Menu x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center"/>
    <TextBlock x:Name="ProjectTitle" Grid.Column="2" Text="Untitled" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button ToolTip="Settings" AutomationProperties.Name="Settings" Click="OpenSettings" Style="{StaticResource IconButton}"><ui:Icon Kind="Settings"/></Button></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
   <Grid Margin="12,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="SelectionTool" Foreground="{DynamicResource Accent}" Background="{DynamicResource Selection}" Style="{StaticResource IconButton}" ToolTip="Selection tool (V)" Click="SelectTool" AutomationProperties.Name="Selection tool"><ui:Icon Kind="Select" Stroke="{Binding Foreground, ElementName=SelectionTool}"/></Button><Button Style="{StaticResource IconButton}" ToolTip="New text layer (Ctrl+Alt+Shift+T)" AutomationProperties.Name="New text layer" Click="AddText"><ui:Icon Kind="Text"/></Button><Button Style="{StaticResource IconButton}" x:Name="ShapeToolButton" ToolTip="Draw shape · right-click for shape types" AutomationProperties.Name="Shape tool" Click="AddShape" PreviewMouseRightButtonDown="ShapeToolsMenu"><ui:Icon Kind="Shape" Stroke="{Binding Foreground, ElementName=ShapeToolButton}"/></Button><Border Width="1" Background="{DynamicResource Border}" Margin="12,4"/><Button Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Click="UndoClick"><ui:Icon Kind="Undo"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Shift+Z)" AutomationProperties.Name="Redo" Click="RedoClick"><ui:Icon Kind="Redo"/></Button><Button Margin="6,0" ToolTip="Split selected layers at playhead (Ctrl+Shift+D)" Click="SplitClick"><StackPanel Orientation="Horizontal"><ui:Icon Kind="Split"/><TextBlock Text="Split" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button><Border Width="1" Background="{DynamicResource Border}" Margin="8,4"/><Button x:Name="SnapButton" Foreground="{DynamicResource Accent}" ToolTip="Toggle frame snapping" Click="ToggleSnap"><StackPanel Orientation="Horizontal"><ui:Icon Kind="Snap" Stroke="{Binding Foreground, ElementName=SnapButton}"/><TextBlock Text="Snapping" Foreground="{Binding Foreground, ElementName=SnapButton}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AIButton" Foreground="{DynamicResource Muted}" BorderBrush="{DynamicResource Border}" Margin="0,0,9,0" Click="ToggleAI" AutomationProperties.Name="AI Editing"><StackPanel Orientation="Horizontal"><ui:Icon Kind="AI" Stroke="{Binding Foreground, ElementName=AIButton}"/><TextBlock Text="AI Editing" Foreground="{Binding Foreground, ElementName=AIButton}" FontWeight="Medium" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource PrimaryButton}" Padding="13,4" Click="ExportClick" AutomationProperties.Name="Export"><StackPanel Orientation="Horizontal"><ui:Icon Kind="Export" Width="14" Height="14" Stroke="{DynamicResource OnPrimary}"/><TextBlock Text="Export" Foreground="{DynamicResource OnPrimary}" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/></StackPanel></Button></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" x:Name="WorkspaceGrid">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProjectColumn" Width="286" MinWidth="200"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="290"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="318" MinWidth="250"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
    <Grid Margin="14,0"><TextBlock Text="Project" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="AssetCount" Text="0 items" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></Grid>
    <TextBox x:Name="AssetSearch" Grid.Row="1" Margin="12,2,12,10" Tag="Search media or bins…" ToolTip="Search media by name or bin" TextChanged="SearchAssets" AutomationProperties.Name="Search project assets"/>
    <Grid Grid.Row="2" Margin="5,0"><ListBox x:Name="AssetList" SelectionMode="Extended" MouseDoubleClick="AssetDoubleClick" PreviewMouseLeftButtonDown="AssetMouseDown" MouseMove="AssetMouseMove" SelectionChanged="AssetSelectionChanged" PreviewMouseRightButtonDown="AssetRightClick">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Workspace}" CornerRadius="3" Width="52" Height="36"><Grid><TextBlock Text="{Binding Icon}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border x:Name="EmptyAssets" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="12,12,12,32" Padding="18" VerticalAlignment="Center" MouseLeftButtonDown="ImportClick"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↧" Foreground="{DynamicResource Accent}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="No media" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,7"/><TextBlock Text="" TextAlignment="Center" Style="{StaticResource MutedText}" LineHeight="19"/><Button Content="Import" Margin="8,18,8,0" BorderBrush="{DynamicResource Border}" Click="ImportClick"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="9,6"><Button Content="＋ Import" HorizontalAlignment="Left" Click="ImportClick"/><Button Content="⋯" HorizontalAlignment="Right" ToolTip="Asset actions" Click="AssetMenuClick"/></Grid></Border>
   </Grid></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><DockPanel Margin="14,0"><ComboBox x:Name="CompositionPicker" MinWidth="139" Height="29" SelectionChanged="CompositionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock x:Name="CompositionMeta" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}" TextAlignment="Right"/></DockPanel></Border>
    <Grid Grid.Row="1" Background="#121212" x:Name="Viewer" ClipToBounds="True" SizeChanged="ViewerSizeChanged" MouseLeftButtonDown="ViewerMouseDown" MouseMove="ViewerMouseMove" MouseLeftButtonUp="ViewerMouseUp" PreviewMouseWheel="ViewerWheel" MouseDown="ViewerMiddleDown" MouseUp="ViewerMiddleUp">
     <Image x:Name="PreviewImage" Stretch="Uniform" Margin="24" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Canvas x:Name="ViewerOverlay" Margin="24" IsHitTestVisible="False"/>
     <Canvas x:Name="ViewerEditOverlay" Margin="24" IsHitTestVisible="False" Panel.ZIndex="2"/>
     <StackPanel x:Name="EmptyViewer" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Empty composition" FontSize="14" Foreground="#B3ADA6" HorizontalAlignment="Center"/><TextBlock Text="" FontSize="14" Foreground="#F0A268" HorizontalAlignment="Center" Margin="0,3,0,19"/><TextBlock Text="" FontSize="11" Foreground="#938D86" HorizontalAlignment="Center"/><TextBlock Text="" FontSize="9" Foreground="#6F6962" HorizontalAlignment="Center" Margin="0,22,0,0"/></StackPanel>
     <Border x:Name="FrameNotice" Background="#D9201E1B" CornerRadius="4" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed"><TextBlock x:Name="FrameNoticeText" Text="Rendering frame…" Foreground="#F3EDE4" FontSize="10"/></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ViewerZoomButton" Content="Fit" MinWidth="39" Padding="4,0" Margin="0,0,3,0" Click="ViewerZoomMenu" ToolTip="Preview zoom · mouse wheel to zoom, middle drag to pan"/><ComboBox x:Name="PreviewQuality" Width="85" SelectionChanged="QualityChanged"><ComboBoxItem Content="Full"/><ComboBoxItem Content="Half" IsSelected="True"/><ComboBoxItem Content="Quarter"/></ComboBox><Button x:Name="GuideButton" Style="{StaticResource IconButton}" ToolTip="Toggle safe-area guides" AutomationProperties.Name="Safe-area guides" Click="ToggleGuides"><ui:Icon Kind="Grid" Width="14" Height="14" Stroke="{Binding Foreground, ElementName=GuideButton}"/></Button></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource IconButton}" ToolTip="Previous frame (Page Up)" Click="PreviousFrame" AutomationProperties.Name="Previous frame"><ui:Icon Kind="Previous" Width="14" Height="14"/></Button><Button x:Name="PlayButton" Style="{StaticResource IconButton}" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause" Click="PlayClick"><ui:Icon Kind="Play" Stroke="{DynamicResource Text}" Width="15" Height="15"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Next frame (Page Down)" Click="NextFrame" AutomationProperties.Name="Next frame"><ui:Icon Kind="Next" Width="14" Height="14"/></Button></StackPanel><TextBox x:Name="ViewerTime" Grid.Column="2" Width="105" Padding="5,1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Text="00:00:00:00" KeyDown="TimeEntry" ToolTip="Enter a frame number or HH:MM:SS:FF"/></Grid></Border>
   </Grid>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
   <Border Grid.Column="4" Background="{DynamicResource Panel}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><TextBlock Text="Properties" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InspectorBody" Margin="17,8,17,22"/></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <GridSplitter x:Name="AISplitter" Grid.Row="2" Grid.RowSpan="4" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="AISplitterCompleted" Visibility="Collapsed" AutomationProperties.Name="Resize AI sidebar"/>
  <Border x:Name="AISidebar" Grid.Row="2" Grid.RowSpan="4" Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Visibility="Collapsed">
   <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Continue">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
     <DockPanel Margin="13,0,7,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ToggleAI" ToolTip="Close sidebar" AutomationProperties.Name="Close AI sidebar"><ui:Icon Kind="Close"/></Button>
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenAISettings" ToolTip="AI connection settings" AutomationProperties.Name="AI connection settings"><ui:Icon Kind="Settings"/></Button>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:Icon Kind="AI" Stroke="{DynamicResource Accent}"/><TextBlock Text="AI Editing" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Margin="14,9,14,0" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}">
     <DockPanel LastChildFill="True">
      <TextBlock x:Name="ChatActivity" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
      <TextBlock x:Name="ChatConnection" Text="Not connected" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="2" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="ChatHistory" Margin="14,9,14,4"/>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Margin="11,7,11,11">
     <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Elevated}" Padding="7,5,5,5">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="124" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="4,4,4,3" Tag="Ask Kuro…" ToolTip="Send with Ctrl+Enter" KeyDown="ComposerKeyDown" TextChanged="ComposerChanged" AutomationProperties.Name="AI editing request"/>
       <DockPanel Grid.Row="1" Margin="0,3,0,0">
        <Button x:Name="SendAIButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="27" Height="27" Padding="0" ToolTip="Send (Ctrl+Enter)" Click="SendAI" IsEnabled="False" AutomationProperties.Name="Send"><Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource OnPrimary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,8 L 8,2 L 14,8 M 8,2 L 8,14"/></Button>
        <Button x:Name="StopAIButton" DockPanel.Dock="Right" Content="Stop" Padding="6,3" Visibility="Collapsed" Click="StopAI"/>
        <Button x:Name="ModelButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenAISettings" ToolTip="Model settings" AutomationProperties.Name="Model settings"><ui:Icon Kind="Settings" Width="13" Height="13"/></Button>
        <TextBlock x:Name="ContextChip" Style="{StaticResource MutedText}" Margin="4,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
      </Grid>
     </Border>
    </StackPanel>
   </Grid>
  </Border>
  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
  <Grid Grid.Row="4" Background="{DynamicResource Panel}"><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="TimelineTitle" Text="Composition 01" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  /  Timeline" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="GraphButton" Content="Graph editor" ToolTip="Toggle value / speed graph (Shift+F3)" Click="ToggleGraph"/><Button Content="B" Style="{StaticResource IconButton}" ToolTip="Set work area start at playhead (B)" Click="WorkStartClick"/><Button Content="N" Style="{StaticResource IconButton}" ToolTip="Set work area end after playhead (N)" Click="WorkEndClick"/><Button Content="◆" Style="{StaticResource IconButton}" ToolTip="Add composition marker" Click="MarkerClick"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="TimelineTime" Foreground="{DynamicResource Accent}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="−" Style="{StaticResource IconButton}" ToolTip="Zoom timeline out" Click="ZoomOut"/><Button Content="＋" Style="{StaticResource IconButton}" ToolTip="Zoom timeline in" Click="ZoomIn"/><Button Content="Fit" ToolTip="Fit composition to timeline" Click="FitTimeline"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1" x:Name="TimelineHost"/>
  </Grid>
  <Border Grid.Row="5" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RuntimeInfo" Grid.Column="1" Text="LOCAL PROCESSING" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Border>
  <Grid x:Name="WelcomeScreen" Grid.Row="1" Grid.RowSpan="5" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{DynamicResource Workspace}" KeyboardNavigation.TabNavigation="Cycle">
   <Border x:Name="WelcomeCard" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Width="760" MinHeight="360" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
    <Border.RenderTransform><TranslateTransform x:Name="WelcomeOffset"/></Border.RenderTransform>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="29,27">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <Image Source="{StaticResource KuroMark}" Width="48" Height="48" HorizontalAlignment="Left"/>
        <TextBlock Text="kuro" FontSize="40" FontWeight="SemiBold" Margin="-2,12,0,0"/>
        <TextBlock Text="Video &amp; motion editor" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Margin="0,20,0,0">
        <Button x:Name="WelcomeNew" Content="＋  New Project" Style="{StaticResource PrimaryButton}" Padding="10,9" Click="WelcomeNewClick"/>
        <Button Content="Open Project…" Margin="0,7,0,0" Padding="10,8" BorderBrush="{DynamicResource Border}" Click="WelcomeOpenClick"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="23,23,23,19">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Recent projects" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
      <ScrollViewer Grid.Row="1" MaxHeight="275" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WelcomeRecent"/></ScrollViewer>
      <Button x:Name="WelcomeRecovery" Grid.Row="2" HorizontalAlignment="Left" Content="Recover autosaved project…" Margin="0,8,0,0" Click="WelcomeRecoveryClick" Visibility="Collapsed"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="Notification" Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" MaxWidth="420" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NotificationText" TextWrapping="Wrap" LineHeight="19"/><Button Grid.Column="1" Content="×" VerticalAlignment="Top" Margin="10,-5,-6,0" Style="{StaticResource IconButton}" Click="DismissNotification"/></Grid></Border>
 </Grid>
</Window>
